# dependencies (composer install)
/vendor/
composer.phar

# local configs / secrets
*-local.php
!/environments/**/*-local.php
.env
*.pem
*.key

# runtime & generated
/frontend/runtime/*
/console/runtime/*
# Yii published asset bundles (hashed dirs); theme files in assets/ are tracked
/frontend/web/assets/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/
__MACOSX/

# personal / uploaded files
/frontend/protected_folders/

# backups & archives
*.bak*
*.zip
*.gz
*.sql

# OS / editor
.DS_Store
.idea/
.vscode/
